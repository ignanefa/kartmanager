# Supabase — copiá estos valores desde supabase.com → Settings → API
# IMPORTANTE: copiá este archivo como ".env.local" y completá los valores reales.
# El archivo ".env.local" NUNCA se sube a GitHub (está en .gitignore).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# service_role key: NO va acá todavía.
# Cuando la necesitemos (operaciones admin en el servidor), se agrega en ese momento.
# SUPABASE_SERVICE_ROLE_KEY=
